diff --git a/index.html b/index.html
index b396b48..08fd3e6 100644
--- a/index.html
+++ b/index.html
@@ -10,6 +10,43 @@
         document.documentElement.classList.add('desktop-lyric-window')
       }
     </script>
+    <script>
+      // [TEMP perf probe] 主线程长任务 + rAF 帧间隔记录，3.5s 后 POST 到 /__perf
+      ;(function () {
+        if (window.__perfProbe) return
+        var P = (window.__perfProbe = { longtasks: [], raf: [], marks: [], t0: performance.now() })
+        try {
+          new PerformanceObserver(function (l) {
+            l.getEntries().forEach(function (e) {
+              P.longtasks.push([Math.round(e.startTime), Math.round(e.duration)])
+            })
+          }).observe({ type: 'longtask', buffered: true })
+        } catch (e) {
+          P.noLongtask = true
+        }
+        var last = performance.now()
+        function tick() {
+          var now = performance.now()
+          var d = now - last
+          last = now
+          P.raf.push([Math.round(now - P.t0), Math.round(d * 10) / 10])
+          if (now - P.t0 < 3600) requestAnimationFrame(tick)
+        }
+        requestAnimationFrame(tick)
+        window.__perfMark = function (name, ts) {
+          P.marks.push([name, Math.round((ts || performance.now()) - P.t0)])
+        }
+        setTimeout(function () {
+          try {
+            fetch('/__perf', {
+              method: 'POST',
+              headers: { 'Content-Type': 'application/json' },
+              body: JSON.stringify({ longtasks: P.longtasks, raf: P.raf, marks: P.marks, noLongtask: P.noLongtask })
+            }).catch(function () {})
+          } catch (e) {}
+        }, 3600)
+      })()
+    </script>
     <style>
       html.desktop-lyric-window,
       html.desktop-lyric-window body,
