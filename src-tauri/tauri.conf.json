{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-utils/schema.json",
  "productName": "树夏Music",
  "mainBinaryName": "ceru-music",
  "version": "1.0.0",
  "identifier": "com.cerumusic.tauri",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1421",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && npm run sidecar:prepare-runtime && npm run mpv:prepare-runtime"
  },
  "app": {
    "windows": [
      {
        "title": "树夏Music",
        "width": 1100,
        "height": 750,
        "minWidth": 1100,
        "minHeight": 670,
        "decorations": true,
        "transparent": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": -100,
          "y": 0
        },
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "backgroundThrottling": "throttle"
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "publisher": "树夏Music",
    "category": "Music",
    "shortDescription": "树夏Music",
    "longDescription": "树夏Music 桌面播放器，支持插件音源、播客、下载和桌面歌词。",
    "resources": {
      "../sidecar": "sidecar",
      "../packaging/sidecar-runtime": "sidecar-runtime",
      "../packaging/mpv": "mpv"
    },
    "macOS": {
      "infoPlist": "Info.plist"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installMode": "both",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true,
        "startMenuFolder": "树夏Music",
        "compression": "lzma"
      }
    },
    "icon": [
      "icons/16x16.png",
      "icons/24x24.png",
      "icons/32x32.png",
      "icons/48x48.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/1024x1024.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://github.com/maiga512/shuxiamusic-release/releases/download/desktop-latest/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcxNTUwMDRBMEM0RjY0MUUKUldRZVpFOE1TZ0JWY1k0UWgvTkNHbHIwOEE3T0FOUXdaY0VBR2xtWDhyUGM5SFduL2hXRkM2YkMK",
      "windows": {
        "installMode": "both"
      }
    }
  }
}
