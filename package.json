{
  "name": "ceru-tauri",
  "private": true,
  "version": "1.1.0",
  "description": "树夏Music 桌面音乐播放器，基于 Tauri、Rust、Vue 3 和 Node sidecar 构建。",
  "keywords": [
    "tauri",
    "vue",
    "music-player",
    "desktop-lyrics",
    "podcast",
    "downloads",
    "music-sources",
    "node-sidecar"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "sidecar:prepare-runtime": "node scripts/prepare-sidecar-runtime.mjs",
    "mpv:prepare-runtime": "node scripts/prepare-mpv-runtime.mjs",
    "tauri:build": "npm run sidecar:prepare-runtime && npm run mpv:prepare-runtime && tauri build",
    "tauri:build:windows": "npm run sidecar:prepare-runtime -- --platform win32 --arch x64 && npm run mpv:prepare-runtime && tauri build --target x86_64-pc-windows-msvc --bundles nsis",
    "tauri:build:windows:arm64": "npm run sidecar:prepare-runtime -- --platform win32 --arch arm64 && npm run mpv:prepare-runtime && tauri build --target aarch64-pc-windows-msvc --bundles nsis",
    "tauri:build:macos": "npm run sidecar:prepare-runtime -- --platform darwin && npm run mpv:prepare-runtime && tauri build --bundles app,dmg"
  },
  "dependencies": {
    "@applemusic-like-lyrics/lyric": "^1.0.0",
    "@applemusic-like-lyrics/vue": "^0.4.2",
    "@logto/browser": "^3.0.10",
    "@logto/vue": "^3.0.10",
    "@lrc-player/core": "^1.1.5",
    "@lrc-player/parse": "^1.0.0",
    "@pixi/app": "^7.4.3",
    "@pixi/core": "^7.4.3",
    "@pixi/display": "^7.4.3",
    "@pixi/filter-blur": "^7.4.3",
    "@pixi/filter-bulge-pinch": "^5.1.1",
    "@pixi/filter-color-matrix": "^7.4.3",
    "@pixi/sprite": "^7.4.3",
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-dialog": "^2.8.2",
    "@tauri-apps/plugin-fs": "2.6",
    "@tauri-apps/plugin-global-shortcut": "^2.4.1",
    "@tauri-apps/plugin-notification": "2.5",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-shell": "2.4",
    "@tensorflow/tfjs": "^4.22.0",
    "animate.css": "^4.1.1",
    "axios": "^1.13.2",
    "color-extraction": "^1.0.8",
    "crypto-js": "^4.2.0",
    "dompurify": "^3.2.6",
    "iconv-lite": "^0.7.0",
    "lodash": "^4.17.21",
    "markdown-it-footnote": "^4.0.0",
    "marked": "^16.1.2",
    "mitt": "^3.0.1",
    "naive-ui": "^2.43.1",
    "nsfwjs": "^4.3.0",
    "pinia": "^3.0.2",
    "pinia-plugin-persistedstate": "4.5.0",
    "qrcode": "^1.5.4",
    "shazamio-core": "^1.3.1",
    "socket.io-client": "^4.8.3",
    "tdesign-icons-vue-next": "^0.4.1",
    "tdesign-vue-next": "^1.15.2",
    "three": "^0.184.0",
    "uuid": "^13.0.0",
    "virtua": "^0.49.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.2",
    "@types/crypto-js": "^4.2.2",
    "@types/dompurify": "^3.2.0",
    "@types/lodash": "^4.17.0",
    "@types/qrcode": "^1.5.6",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vueuse/core": "^13.9.0",
    "sass-embedded": "^1.90.0",
    "typescript": "~5.7.3",
    "unplugin-auto-import": "^19.1.2",
    "unplugin-vue-components": "^28.5.0",
    "vite": "^6.3.0",
    "vue-tsc": "^2.2.0"
  }
}
